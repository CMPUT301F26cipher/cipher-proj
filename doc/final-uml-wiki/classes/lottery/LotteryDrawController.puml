@startuml
!import doc/final-uml-wiki/style.puml

class LotteryDrawController {
    +isReadyToDraw(lottery: Lottery, today: LocalDate): Boolean
    +pickWinners(entries: List<LotteryEntry>, numWinners: Int, random: Random): List<LotteryEntry>
    +drawLottery(lottery: Lottery, onResult: (Result<Unit>) -> Unit)
    +drawExpiredLotteries(today: LocalDate)
    -saveEntries(entries: List<LotteryEntry>, onDone: (Result<Unit>) -> Unit)
}
